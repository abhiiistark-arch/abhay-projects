# =============================================================================
# YouTube Shorts Automation Pipeline — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Required: Your Google Gemini API key (with Veo 3.1 access)
GEMINI_API_KEY=

# AI Models
VEO_MODEL=veo-3.1-generate-preview
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# YouTube Data API upload (OAuth — one-time setup, free within quota)
# Run: python scripts/youtube_oauth_setup.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CATEGORY_ID=22
YOUTUBE_UPLOAD_PRIVACY=UNLISTED

# Pipeline Settings
MAX_PARALLEL_VIDEOS=4
TOP_TRENDS_COUNT=20
VIDEOS_PER_PIPELINE=4
SEGMENTS_PER_VIDEO=7
MAX_VIDEO_DURATION_SECONDS=58
VEO_PERSON_GENERATION=
VEO_POLL_MAX_SECONDS=900

# Database
DATABASE_URL=sqlite:///./data/shorts_pipeline.db

# Redis / Celery (local — no Docker)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Paths
OUTPUT_DIR=data/output
TEMP_DIR=data/temp
THUMBNAIL_DIR=data/thumbnails

# API
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false
LOCAL_ONLY=true
