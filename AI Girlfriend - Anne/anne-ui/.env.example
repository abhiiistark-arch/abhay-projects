# LiveKit — required for voice sessions
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch — must match gemini-agent/src/agent.py (@server.rtc_session agent_name)
AGENT_NAME=gemini-agent

# Authentication — set in Vercel dashboard for production
APP_PASSWORD=abhayislove
AUTH_SECRET=<generate-a-long-random-string>

# Production app URL (for CORS) — e.g. https://anne.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional sandbox mode
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
