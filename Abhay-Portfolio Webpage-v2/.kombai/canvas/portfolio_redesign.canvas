      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Inter:wght@300;400;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-bg: #0A0A0A;\n    --color-surface: #111111;\n    --color-text-primary: #CCCCCC;\n    --color-text-muted: #666666;\n    --color-accent-warm: #FF8A4D;\n    --color-accent-cyan: #00F5FF;\n    --color-glass: rgba(255, 255, 255, 0.03);\n    --color-border: rgba(255, 255, 255, 0.08);\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: var(--color-text-primary);\n    font-family: 'Inter', sans-serif;\n    overflow-x: hidden;\n  }\n\n  .font-serif { font-family: 'Cormorant Garamond', serif; }\n  .font-mono-meta { font-family: 'Inter', sans-serif; font-weight: 300; letter-spacing: 0.1em; font-size: 0.7rem; text-transform: uppercase; }\n\n  .glass-card {\n    background: var(--color-glass);\n    backdrop-filter: blur(20px);\n    border: 1px solid var(--color-border);\n  }\n\n  /* Custom Animations */\n  .geometric-bg {\n    background-image: url('https://images.unsplash.com/photo-1649939929524-681f8b1faa07?auto=format&w=1440&q=80');\n    background-size: cover;\n    background-position: center;\n    opacity: 0.15;\n    mix-blend-mode: overlay;\n  }\n\n  .diamond-grid-item {\n    transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1), z-index 0s;\n  }\n\n  .diamond-inner {\n    transform: rotate(45deg);\n    overflow: hidden;\n    transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);\n  }\n\n  .diamond-content {\n    transform: rotate(-45deg);\n    transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);\n  }\n\n  .diamond-grid-item:hover {\n    z-index: 50;\n  }\n\n  .diamond-grid-item:hover .diamond-inner {\n    transform: rotate(0deg) scale(1.1);\n  }\n\n  .diamond-grid-item:hover .diamond-content {\n    transform: rotate(0deg);\n  }\n\n  .ledger-row {\n    border-bottom: 1px solid var(--color-surface);\n    transition: all 0.4s ease;\n  }\n\n  .ledger-row:hover {\n    background: var(--color-surface);\n  }\n\n  .ledger-row:hover .accent-reveal {\n    opacity: 1;\n    transform: translateX(0);\n  }\n\n  .text-gradient-warm {\n    background: linear-gradient(to right, var(--color-accent-warm), var(--color-accent-cyan));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .noise-overlay {\n    position: fixed;\n    top: 0; left: 0; width: 100%; height: 100%;\n    background: url('https://grainy-gradients.vercel.app/noise.svg');\n    opacity: 0.05;\n    pointer-events: none;\n    z-index: 9999;\n  }\n\n  .mix-blend-difference { mix-blend-mode: difference; }\n</style>\n\n<div class=\"noise-overlay\" data-kid=\"1\"></div>\n\n\n<nav class=\"fixed top-0 left-0 w-full z-[100] px-12 py-8 flex justify-between items-end pointer-events-none\" data-kid=\"2\">\n  <div class=\"pointer-events-auto\" data-kid=\"3\">\n    <div class=\"font-serif text-2xl tracking-tighter mix-blend-difference\" data-kid=\"4\">A. PANDEY</div>\n    <div class=\"font-mono-meta text-muted\" data-kid=\"5\">Portfolio Vol. 03</div>\n  </div>\n  <div class=\"flex gap-12 pointer-events-auto font-mono-meta mix-blend-difference\" data-kid=\"6\">\n    <a href=\"#about\" class=\"hover:text-[var(--color-accent-warm)] transition-colors\" data-kid=\"7\">/ About</a>\n    <a href=\"#projects\" class=\"hover:text-[var(--color-accent-warm)] transition-colors\" data-kid=\"8\">/ Projects</a>\n    <a href=\"#experience\" class=\"hover:text-[var(--color-accent-warm)] transition-colors\" data-kid=\"9\">/ Experience</a>\n    <a href=\"#contact\" class=\"hover:text-[var(--color-accent-warm)] transition-colors\" data-kid=\"10\">/ Contact</a>\n  </div>\n</nav>\n\n\n<main id=\"smooth-wrapper\" data-kid=\"11\">\n  <div id=\"smooth-content\" data-kid=\"12\">\n    \n    \n    <section class=\"relative min-h-screen flex items-center justify-center overflow-hidden\" data-kid=\"13\">\n      <div class=\"absolute inset-0 geometric-bg\" data-kid=\"14\"></div>\n      \n      \n      <div class=\"absolute top-12 left-12 font-serif text-[clamp(2rem,6vw,8rem)] leading-none opacity-20 select-none\" data-kid=\"15\">ABHAY</div>\n      <div class=\"absolute top-12 right-12 font-serif text-[clamp(2rem,6vw,8rem)] leading-none opacity-20 select-none text-right\" data-kid=\"16\">PANDEY</div>\n      <div class=\"absolute bottom-12 left-12 font-serif text-[clamp(2rem,6vw,8rem)] leading-none opacity-20 select-none\" data-kid=\"17\">CREATIVE</div>\n      <div class=\"absolute bottom-12 right-12 font-serif text-[clamp(2rem,6vw,8rem)] leading-none opacity-20 select-none text-right\" data-kid=\"18\">ENGINEER</div>\n\n      \n      <div class=\"relative z-10 group\" data-kid=\"19\">\n        <div class=\"glass-card w-[400px] h-[550px] p-2 rotate-[-2deg] transition-transform duration-700 group-hover:rotate-0\" data-kid=\"20\">\n          <div class=\"w-full h-full overflow-hidden grayscale contrast-125 transition-all duration-700 group-hover:grayscale-0\" data-kid=\"21\">\n            <img src=\"https://images.unsplash.com/photo-1594751684241-bcef815d5a57?auto=format&w=800&q=80\" alt=\"Abhay Pandey\" class=\"w-full h-full object-cover\" loading=\"lazy\" decoding=\"async\" data-kid=\"22\">\n          </div>\n        </div>\n        \n        <div class=\"absolute -bottom-24 -right-12 text-right\" data-kid=\"23\">\n          <p class=\"font-serif italic text-4xl mb-2\" data-kid=\"24\">Architecting digital</p>\n          <p class=\"font-serif italic text-4xl\" data-kid=\"25\">masterpieces.</p>\n          <div class=\"mt-4 flex justify-end gap-4 items-center\" data-kid=\"26\">\n            <span class=\"font-mono-meta text-muted\" data-kid=\"27\">Currently based in India</span>\n            <div class=\"w-12 h-px bg-white/20\" data-kid=\"28\"></div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4\" data-kid=\"29\">\n        <div class=\"font-mono-meta opacity-40\" data-kid=\"30\">Scroll to Explore</div>\n        <div class=\"w-px h-24 bg-gradient-to-b from-white/40 to-transparent\" data-kid=\"31\"></div>\n      </div>\n    </section>\n\n    \n    <section id=\"about\" class=\"relative py-48 px-12 md:px-24 bg-[var(--color-bg)]\" data-kid=\"32\">\n      <div class=\"grid grid-cols-12 gap-8 items-center\" data-kid=\"33\">\n        \n        <div class=\"col-span-12 lg:col-span-5 relative h-[600px]\" data-kid=\"34\">\n          <div class=\"absolute top-0 left-0 w-3/4 h-3/4 glass-card z-20 translate-x-8 translate-y-8 p-4\" data-kid=\"35\">\n             <img src=\"https://images.unsplash.com/photo-1527049979667-990f1d0d8e7f?auto=format&w=800&q=80\" alt=\"Macro Detail\" class=\"w-full h-full object-cover opacity-60\" loading=\"lazy\" decoding=\"async\" data-kid=\"36\">\n          </div>\n          <div class=\"absolute bottom-0 right-0 w-3/4 h-3/4 border border-white/10 z-10 translate-x-[-8px] translate-y-[-8px]\" data-kid=\"37\"></div>\n          <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-gradient-to-tr from-[var(--color-accent-cyan)]/10 to-transparent blur-3xl opacity-30\" data-kid=\"38\"></div>\n        </div>\n\n        \n        <div class=\"col-span-12 lg:col-span-7 pl-0 lg:pl-12\" data-kid=\"39\">\n          <div class=\"font-mono-meta text-[var(--color-accent-warm)] mb-6\" data-kid=\"40\">/ 01 Background</div>\n          <h2 class=\"font-serif text-6xl md:text-8xl mb-12 leading-[0.9]\" data-kid=\"41\">Beyond the <br data-kid=\"42\"><span class=\"italic text-white/40\" data-kid=\"43\">Visible Surface.</span></h2>\n          <div class=\"max-w-xl space-y-8 font-serif text-2xl text-white/80 leading-relaxed\" data-kid=\"44\">\n            <p data-kid=\"45\">\n              I am a creative engineer specializing in high-fidelity user experiences. My work resides at the intersection of precise logic and evocative design.\n            </p>\n            <p class=\"text-xl font-sans font-light text-muted\" data-kid=\"46\">\n              Leveraging advanced tech stacks like React, Next.js, and Framer Motion, I build interfaces that don't just function—they breathe. Every pixel is a calculated decision in a larger geometric symphony.\n            </p>\n          </div>\n          \n          \n          <div class=\"mt-16 grid grid-cols-2 gap-12 pt-12 border-t border-white/5\" data-kid=\"47\">\n            <div data-kid=\"48\">\n              <div class=\"font-mono-meta mb-4\" data-kid=\"49\">Core Competencies</div>\n              <ul class=\"font-serif text-lg space-y-1 text-muted\" data-kid=\"50\">\n                <li data-kid=\"51\">Frontend Architecture</li>\n                <li data-kid=\"52\">Motion Choreography</li>\n                <li data-kid=\"53\">Design Systems</li>\n                <li data-kid=\"54\">Web Performance</li>\n              </ul>\n            </div>\n            <div data-kid=\"55\">\n              <div class=\"font-mono-meta mb-4\" data-kid=\"56\">Philosophy</div>\n              <p class=\"font-serif italic text-lg text-muted\" data-kid=\"57\">\"Elegance is not abundance, but the perfect elimination of the unnecessary.\"</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"projects\" class=\"py-48 px-12 bg-[var(--color-surface)]\" data-kid=\"58\">\n      <div class=\"flex justify-between items-end mb-32\" data-kid=\"59\">\n        <h2 class=\"font-serif text-7xl italic leading-none\" data-kid=\"60\">Selected <br data-kid=\"61\">Works.</h2>\n        <div class=\"font-mono-meta text-muted text-right max-w-xs\" data-kid=\"62\">\n          Hover items to deconstruct the geometry. Each project is a milestone in technical exploration.\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-32 gap-x-12 px-12\" data-kid=\"63\">\n        \n        <div class=\"diamond-grid-item relative aspect-square\" data-kid=\"64\">\n          <div class=\"diamond-inner w-full h-full glass-card group\" data-kid=\"65\">\n            <div class=\"diamond-content w-full h-full relative\" data-kid=\"66\">\n              <img src=\"https://images.unsplash.com/photo-1720962158937-7ea890052166?auto=format&w=800&q=80\" alt=\"Project 1\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700\" loading=\"lazy\" decoding=\"async\" data-kid=\"67\">\n              <div class=\"absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-8\" data-kid=\"68\">\n                 <div class=\"font-mono-meta text-white\" data-kid=\"69\">Full Stack / 2024</div>\n                 <h3 class=\"font-serif text-4xl text-white mt-2\" data-kid=\"70\">Cyber-Nexus</h3>\n              </div>\n            </div>\n          </div>\n          <div class=\"mt-8 text-center md:text-left\" data-kid=\"71\">\n            <div class=\"font-mono-meta text-muted mb-2\" data-kid=\"72\">01 / Next.js + Three.js</div>\n            <h3 class=\"font-serif text-3xl\" data-kid=\"73\">Immersive Dashboard</h3>\n          </div>\n        </div>\n\n        \n        <div class=\"diamond-grid-item relative aspect-square lg:mt-32\" data-kid=\"74\">\n          <div class=\"diamond-inner w-full h-full glass-card group\" data-kid=\"75\">\n            <div class=\"diamond-content w-full h-full relative\" data-kid=\"76\">\n              <img src=\"https://images.unsplash.com/photo-1720962158789-9389a4f399da?auto=format&w=800&q=80\" alt=\"Project 2\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700\" loading=\"lazy\" decoding=\"async\" data-kid=\"77\">\n              <div class=\"absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-8\" data-kid=\"78\">\n                 <div class=\"font-mono-meta text-white\" data-kid=\"79\">Interface / 2023</div>\n                 <h3 class=\"font-serif text-4xl text-white mt-2\" data-kid=\"80\">Void Interface</h3>\n              </div>\n            </div>\n          </div>\n          <div class=\"mt-8 text-center md:text-left\" data-kid=\"81\">\n            <div class=\"font-mono-meta text-muted mb-2\" data-kid=\"82\">02 / React + Framer</div>\n            <h3 class=\"font-serif text-3xl\" data-kid=\"83\">Minimalist OS</h3>\n          </div>\n        </div>\n\n        \n        <div class=\"diamond-grid-item relative aspect-square\" data-kid=\"84\">\n          <div class=\"diamond-inner w-full h-full glass-card group\" data-kid=\"85\">\n            <div class=\"diamond-content w-full h-full relative\" data-kid=\"86\">\n              <img src=\"https://images.unsplash.com/photo-1771873680097-7506773a2b02?auto=format&w=800&q=80\" alt=\"Project 3\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700\" loading=\"lazy\" decoding=\"async\" data-kid=\"87\">\n              <div class=\"absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-8\" data-kid=\"88\">\n                 <div class=\"font-mono-meta text-white\" data-kid=\"89\">E-Commerce / 2024</div>\n                 <h3 class=\"font-serif text-4xl text-white mt-2\" data-kid=\"90\">Lux Studio</h3>\n              </div>\n            </div>\n          </div>\n          <div class=\"mt-8 text-center md:text-left\" data-kid=\"91\">\n            <div class=\"font-mono-meta text-muted mb-2\" data-kid=\"92\">03 / Shopify + GSAP</div>\n            <h3 class=\"font-serif text-3xl\" data-kid=\"93\">Premium Boutique</h3>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"experience\" class=\"py-48 px-12 md:px-24\" data-kid=\"94\">\n      <div class=\"font-mono-meta text-center mb-12\" data-kid=\"95\">Professional Logbook</div>\n      <h2 class=\"font-serif text-7xl text-center mb-32 italic\" data-kid=\"96\">The Tenure.</h2>\n      \n      <div class=\"max-w-5xl mx-auto border-t border-white/10\" data-kid=\"97\">\n        \n        <div class=\"ledger-row py-12 px-8 flex flex-wrap gap-8 items-center group\" data-kid=\"98\">\n          <div class=\"w-24 font-mono-meta text-muted\" data-kid=\"99\">2023 - Pres</div>\n          <div class=\"flex-1 min-w-[300px]\" data-kid=\"100\">\n            <h3 class=\"font-serif text-4xl group-hover:text-gradient-warm transition-all duration-500\" data-kid=\"101\">Senior Frontend Engineer</h3>\n            <p class=\"font-mono-meta text-muted mt-2\" data-kid=\"102\">Global Tech Solutions • Enterprise</p>\n          </div>\n          <div class=\"w-full md:w-auto text-right\" data-kid=\"103\">\n             <span class=\"font-mono-meta px-4 py-2 border border-white/10 rounded-full group-hover:border-[var(--color-accent-cyan)] group-hover:text-[var(--color-accent-cyan)] transition-colors\" data-kid=\"104\">Remote</span>\n          </div>\n          <i class=\"ti ti-arrow-up-right text-3xl opacity-0 -translate-x-4 transition-all duration-500 group-hover:opacity-100 group-hover:translate-x-0\" data-kid=\"105\"></i>\n        </div>\n\n        \n        <div class=\"ledger-row py-12 px-8 flex flex-wrap gap-8 items-center group\" data-kid=\"106\">\n          <div class=\"w-24 font-mono-meta text-muted\" data-kid=\"107\">2021 - 2023</div>\n          <div class=\"flex-1 min-w-[300px]\" data-kid=\"108\">\n            <h3 class=\"font-serif text-4xl group-hover:text-gradient-warm transition-all duration-500\" data-kid=\"109\">Creative Technologist</h3>\n            <p class=\"font-mono-meta text-muted mt-2\" data-kid=\"110\">Design Hub • Creative Agency</p>\n          </div>\n          <div class=\"w-full md:w-auto text-right\" data-kid=\"111\">\n             <span class=\"font-mono-meta px-4 py-2 border border-white/10 rounded-full group-hover:border-[var(--color-accent-warm)] group-hover:text-[var(--color-accent-warm)] transition-colors\" data-kid=\"112\">On-site</span>\n          </div>\n          <i class=\"ti ti-arrow-up-right text-3xl opacity-0 -translate-x-4 transition-all duration-500 group-hover:opacity-100 group-hover:translate-x-0\" data-kid=\"113\"></i>\n        </div>\n\n        \n        <div class=\"ledger-row py-12 px-8 flex flex-wrap gap-8 items-center group\" data-kid=\"114\">\n          <div class=\"w-24 font-mono-meta text-muted\" data-kid=\"115\">2019 - 2021</div>\n          <div class=\"flex-1 min-w-[300px]\" data-kid=\"116\">\n            <h3 class=\"font-serif text-4xl group-hover:text-gradient-warm transition-all duration-500\" data-kid=\"117\">Junior Developer</h3>\n            <p class=\"font-mono-meta text-muted mt-2\" data-kid=\"118\">StartUp Lab • Product</p>\n          </div>\n          <div class=\"w-full md:w-auto text-right\" data-kid=\"119\">\n             <span class=\"font-mono-meta px-4 py-2 border border-white/10 rounded-full group-hover:border-[var(--color-accent-cyan)] group-hover:text-[var(--color-accent-cyan)] transition-colors\" data-kid=\"120\">Hybrid</span>\n          </div>\n          <i class=\"ti ti-arrow-up-right text-3xl opacity-0 -translate-x-4 transition-all duration-500 group-hover:opacity-100 group-hover:translate-x-0\" data-kid=\"121\"></i>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"contact\" class=\"relative min-h-screen flex items-center justify-center py-24\" data-kid=\"122\">\n      <div class=\"absolute inset-0 overflow-hidden\" data-kid=\"123\">\n        <video src=\"https://videos.pexels.com/video-files/4320606/4320606-uhd_2560_1440_24fps.mp4\" poster=\"https://images.pexels.com/videos/4320606/pexels-photo-4320606.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover opacity-40 brightness-50\" data-kid=\"124\"></video>\n      </div>\n      \n      <div class=\"relative z-10 w-full max-w-4xl px-8 flex flex-col md:flex-row gap-24 items-center\" data-kid=\"125\">\n        \n        <div class=\"flex-1\" data-kid=\"126\">\n          <div class=\"font-mono-meta mb-4\" data-kid=\"127\">Transmission</div>\n          <h2 class=\"font-serif text-8xl mb-12 italic leading-none\" data-kid=\"128\">Initiate <br data-kid=\"129\">Contact.</h2>\n          <div class=\"space-y-6\" data-kid=\"130\">\n            <a href=\"mailto:hello@abhay.dev\" class=\"block font-serif text-3xl hover:text-[var(--color-accent-cyan)] transition-colors underline underline-offset-8\" data-kid=\"131\">hello@abhay.dev</a>\n            <div class=\"flex gap-8 font-mono-meta text-muted mt-12\" data-kid=\"132\">\n              <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"133\">LinkedIn</a>\n              <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"134\">GitHub</a>\n              <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"135\">Twitter / X</a>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"w-full md:w-[450px] glass-card p-12 bg-black/40 shadow-2xl\" data-kid=\"136\">\n          <form class=\"space-y-8\" data-kid=\"137\">\n            <div class=\"space-y-2\" data-kid=\"138\">\n              <label class=\"font-mono-meta text-xs\" data-kid=\"139\">Identity</label>\n              <input type=\"text\" placeholder=\"Your Name\" class=\"w-full bg-transparent border-b border-white/20 py-2 font-serif text-xl focus:outline-none focus:border-[var(--color-accent-cyan)] transition-colors placeholder:text-white/20\" data-kid=\"140\">\n            </div>\n            <div class=\"space-y-2\" data-kid=\"141\">\n              <label class=\"font-mono-meta text-xs\" data-kid=\"142\">Digital Address</label>\n              <input type=\"email\" placeholder=\"email@provider.com\" class=\"w-full bg-transparent border-b border-white/20 py-2 font-serif text-xl focus:outline-none focus:border-[var(--color-accent-cyan)] transition-colors placeholder:text-white/20\" data-kid=\"143\">\n            </div>\n            <div class=\"space-y-2\" data-kid=\"144\">\n              <label class=\"font-mono-meta text-xs\" data-kid=\"145\">Confession</label>\n              <textarea placeholder=\"Your Message...\" rows=\"4\" class=\"w-full bg-transparent border-b border-white/20 py-2 font-serif text-xl focus:outline-none focus:border-[var(--color-accent-cyan)] transition-colors placeholder:text-white/20 resize-none\" data-kid=\"146\"></textarea>\n            </div>\n            <button class=\"w-full py-6 mt-8 border border-white/20 font-serif text-2xl italic hover:bg-white hover:text-black transition-all duration-500\" data-kid=\"147\">Send Transmission</button>\n          </form>\n        </div>\n      </div>\n    </section>\n\n    \n    <footer class=\"py-12 px-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"148\">\n      <div class=\"font-mono-meta text-muted\" data-kid=\"149\">© 2024 Abhay Pandey. All Rights Reserved.</div>\n      <div class=\"font-serif text-xl italic opacity-40\" data-kid=\"150\">Engineering the future of interaction.</div>\n      <div class=\"flex gap-6 font-mono-meta\" data-kid=\"151\">\n        <span class=\"text-[var(--color-accent-cyan)]\" data-kid=\"152\">System Active</span>\n        <span class=\"text-muted\" data-kid=\"153\">v3.0.12</span>\n      </div>\n    </footer>\n\n  </div>\n</main>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"154\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"155\"></script>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"156\">\n<script type=\"module\" data-kid=\"157\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  \n  // Initialize Lenis\n  const lenis = new Lenis({\n    duration: 1.2,\n    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n    smoothWheel: true\n  })\n\n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n\n  // GSAP Animations\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Parallax for Hero Artifact\n  gsap.to('.group', {\n    y: 100,\n    scrollTrigger: {\n      trigger: 'section',\n      start: 'top top',\n      end: 'bottom top',\n      scrub: true\n    }\n  });\n\n  // Fade in sections\n  gsap.utils.toArray('section').forEach(section => {\n    gsap.from(section.querySelectorAll('h2, .font-mono-meta, p, .diamond-grid-item, .ledger-row'), {\n      y: 100,\n      opacity: 0,\n      duration: 1.2,\n      stagger: 0.2,\n      ease: 'power4.out',\n      scrollTrigger: {\n        trigger: section,\n        start: 'top 80%',\n      }\n    });\n  });\n\n  // About Section Parallax Layers\n  gsap.to('#about .glass-card', {\n    y: -50,\n    scrollTrigger: {\n      trigger: '#about',\n      start: 'top bottom',\n      end: 'bottom top',\n      scrub: true\n    }\n  });\n\n  gsap.to('#about .border', {\n    y: 50,\n    scrollTrigger: {\n      trigger: '#about',\n      start: 'top bottom',\n      end: 'bottom top',\n      scrub: true\n    }\n  });\n</script>",
