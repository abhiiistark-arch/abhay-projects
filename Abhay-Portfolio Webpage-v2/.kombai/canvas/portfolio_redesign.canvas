      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  body {\n    background-color: #0A0A0A;\n    color: #FFFFFF;\n    font-family: 'DM Sans', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-serif { font-family: 'Playfair Display', serif; }\n  \n  .glass {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(40px);\n    -webkit-backdrop-filter: blur(40px);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  .glow-cyan {\n    box-shadow: 0 0 80px -10px rgba(0, 245, 255, 0.15);\n  }\n\n  .text-cyan { color: #00F5FF; }\n  .bg-cyan { background-color: #00F5FF; }\n\n  /* Custom Orbit Animation for Hero Name */\n  @keyframes rotate {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(360deg); }\n  }\n  .orbit-text {\n    animation: rotate 20s linear infinite;\n  }\n\n  /* Hide scrollbar but keep functionality */\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n  /* Sinuous line SVG */\n  .timeline-path {\n    stroke-dasharray: 1000;\n    stroke-dashoffset: 1000;\n  }\n</style>\n\n<div id=\"smooth-wrapper\" class=\"relative\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-6 left-1/2 -translate-x-1/2 z-50 glass rounded-full px-8 py-4 flex items-center gap-12\" data-kid=\"2\">\n    <a href=\"#hero\" class=\"text-sm font-medium tracking-widest uppercase hover:text-cyan transition-colors\" data-kid=\"3\">Home</a>\n    <a href=\"#about\" class=\"text-sm font-medium tracking-widest uppercase hover:text-cyan transition-colors\" data-kid=\"4\">About</a>\n    <div class=\"h-8 w-px bg-white/10\" data-kid=\"5\"></div>\n    <span class=\"text-lg font-bold tracking-tighter italic font-serif\" data-kid=\"6\">A.P</span>\n    <div class=\"h-8 w-px bg-white/10\" data-kid=\"7\"></div>\n    <a href=\"#projects\" class=\"text-sm font-medium tracking-widest uppercase hover:text-cyan transition-colors\" data-kid=\"8\">Works</a>\n    <a href=\"#contact\" class=\"text-sm font-medium tracking-widest uppercase hover:text-cyan transition-colors\" data-kid=\"9\">Connect</a>\n  </nav>\n\n  \n  <section id=\"hero\" class=\"h-screen w-full relative flex items-center justify-center overflow-hidden\" data-kid=\"10\">\n    \n    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" data-kid=\"11\">\n      <div class=\"w-[600px] h-[600px] bg-cyan/5 blur-[120px] rounded-full animate-pulse\" data-kid=\"12\"></div>\n    </div>\n\n    \n    <div class=\"relative w-[500px] h-[500px] flex items-center justify-center\" data-kid=\"13\">\n      \n      <svg class=\"absolute inset-0 w-full h-full orbit-text\" viewBox=\"0 0 500 500\" data-kid=\"14\">\n        <path id=\"circlePath\" d=\"M 250, 250 m -220, 0 a 220,220 0 1,1 440,0 a 220,220 0 1,1 -440,0\" fill=\"transparent\" data-kid=\"15\"></path>\n        <text class=\"text-[14px] uppercase tracking-[0.6em] fill-white/40 font-medium\" data-kid=\"16\">\n          <textPath xlink:href=\"#circlePath\" data-kid=\"17\">\n            Abhay Pandey • Professional Developer • Engineering Precision • Digital Architect •\n          </textPath>\n        </text>\n      </svg>\n\n      \n      <div class=\"w-[380px] h-[380px] rounded-full overflow-hidden glass border-white/10 relative z-10 glow-cyan\" data-kid=\"18\">\n        <video src=\"https://videos.pexels.com/video-files/16296848/16296848-uhd_2560_1440_24fps.mp4\" poster=\"https://images.pexels.com/videos/16296848/abstract-background-black-dark-16296848.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover scale-110\" decoding=\"async\" data-kid=\"19\"></video>\n      </div>\n    </div>\n\n    \n    <div class=\"absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4\" data-kid=\"20\">\n      <span class=\"text-[10px] tracking-[0.4em] uppercase text-white/30\" data-kid=\"21\">Scroll Deep</span>\n      <div class=\"w-px h-12 bg-gradient-to-b from-cyan/50 to-transparent\" data-kid=\"22\"></div>\n    </div>\n  </section>\n\n  \n  <section id=\"about\" class=\"min-h-screen py-32 px-24 relative overflow-hidden\" data-kid=\"23\">\n    \n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/nested-hexagons.svg\" class=\"absolute top-20 right-[-5%] w-[40vw] opacity-5 pointer-events-none invert\" alt=\"bg-pattern\" loading=\"lazy\" decoding=\"async\" data-kid=\"24\">\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/nested-hexagons.svg\" class=\"absolute bottom-20 left-[-5%] w-[30vw] opacity-5 pointer-events-none invert rotate-45\" alt=\"bg-pattern\" loading=\"lazy\" decoding=\"async\" data-kid=\"25\">\n\n    <div class=\"max-w-6xl mx-auto flex flex-col items-center text-center\" data-kid=\"26\">\n      <span class=\"text-cyan text-sm tracking-[0.5em] uppercase mb-12 block\" data-kid=\"27\">The Philosophy</span>\n      <h2 id=\"about-text\" class=\"text-[7vw] leading-[1.1] font-bold tracking-tighter mb-16 italic font-serif opacity-0 translate-y-20\" data-kid=\"28\">\n        Precision is not an act, but a <span class=\"text-cyan\" data-kid=\"29\">habit</span>. We build for the future of digital interaction.\n      </h2>\n      <div class=\"grid grid-cols-3 gap-12 w-full mt-12\" data-kid=\"30\">\n        <div class=\"p-8 glass rounded-3xl text-left hover:border-cyan/30 transition-all duration-500 group\" data-kid=\"31\">\n          <i class=\"ti ti-cpu text-3xl text-cyan mb-6 block\" data-kid=\"32\"></i>\n          <h3 class=\"text-xl font-bold mb-4\" data-kid=\"33\">Core Engineering</h3>\n          <p class=\"text-white/50 text-sm leading-relaxed\" data-kid=\"34\">Building robust, scalable architectures with a focus on performance and clean code principles.</p>\n        </div>\n        <div class=\"p-8 glass rounded-3xl text-left hover:border-cyan/30 transition-all duration-500 group translate-y-12\" data-kid=\"35\">\n          <i class=\"ti ti-device-desktop text-3xl text-cyan mb-6 block\" data-kid=\"36\"></i>\n          <h3 class=\"text-xl font-bold mb-4\" data-kid=\"37\">Fluid Interfaces</h3>\n          <p class=\"text-white/50 text-sm leading-relaxed\" data-kid=\"38\">Crafting immersive user experiences that feel natural, biological, and effortlessly smooth.</p>\n        </div>\n        <div class=\"p-8 glass rounded-3xl text-left hover:border-cyan/30 transition-all duration-500 group\" data-kid=\"39\">\n          <i class=\"ti ti-database text-3xl text-cyan mb-6 block\" data-kid=\"40\"></i>\n          <h3 class=\"text-xl font-bold mb-4\" data-kid=\"41\">Data Systems</h3>\n          <p class=\"text-white/50 text-sm leading-relaxed\" data-kid=\"42\">Architecting complex data flows that empower modern applications with speed and reliability.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"projects\" class=\"py-32 bg-[#080808] relative\" data-kid=\"43\">\n    <div class=\"px-24 mb-16 flex justify-between items-end\" data-kid=\"44\">\n      <div data-kid=\"45\">\n        <span class=\"text-cyan text-sm tracking-[0.5em] uppercase mb-4 block\" data-kid=\"46\">Selection</span>\n        <h2 class=\"text-6xl font-bold italic font-serif\" data-kid=\"47\">Selected Monoliths</h2>\n      </div>\n      <div class=\"flex gap-4\" data-kid=\"48\">\n        <button id=\"prevBtn\" class=\"w-14 h-14 rounded-full border border-white/10 flex items-center justify-center hover:bg-white/5 transition-colors\" data-kid=\"49\">\n          <i class=\"ti ti-chevron-left\" data-kid=\"50\"></i>\n        </button>\n        <button id=\"nextBtn\" class=\"w-14 h-14 rounded-full border border-white/10 flex items-center justify-center hover:bg-white/5 transition-colors\" data-kid=\"51\">\n          <i class=\"ti ti-chevron-right\" data-kid=\"52\"></i>\n        </button>\n      </div>\n    </div>\n\n    \n    <div id=\"project-track\" class=\"flex gap-8 px-24 overflow-x-auto no-scrollbar pb-12\" data-kid=\"53\">\n      \n      <div class=\"shrink-0 w-[800px] h-[500px] relative rounded-3xl overflow-hidden group\" data-kid=\"54\">\n        <img src=\"https://images.unsplash.com/photo-1720962158937-7ea890052166?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110\" alt=\"Project 1\" loading=\"lazy\" decoding=\"async\" data-kid=\"55\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent\" data-kid=\"56\"></div>\n        <div class=\"absolute bottom-0 left-0 right-0 p-12 glass backdrop-blur-md translate-y-4 group-hover:translate-y-0 transition-transform duration-500\" data-kid=\"57\">\n          <div class=\"flex justify-between items-center\" data-kid=\"58\">\n            <div data-kid=\"59\">\n              <span class=\"text-cyan text-xs tracking-widest uppercase mb-2 block\" data-kid=\"60\">Fintech Platform</span>\n              <h3 class=\"text-3xl font-bold\" data-kid=\"61\">The Oracle Dashboard</h3>\n            </div>\n            <a href=\"#\" class=\"w-16 h-16 rounded-full bg-cyan flex items-center justify-center text-black hover:scale-110 transition-transform\" data-kid=\"62\">\n              <i class=\"ti ti-arrow-up-right text-2xl\" data-kid=\"63\"></i>\n            </a>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"shrink-0 w-[600px] h-[500px] relative rounded-3xl overflow-hidden group\" data-kid=\"64\">\n        <img src=\"https://images.unsplash.com/photo-1651505942687-efc26cb528ba?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110\" alt=\"Project 2\" loading=\"lazy\" decoding=\"async\" data-kid=\"65\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent\" data-kid=\"66\"></div>\n        <div class=\"absolute bottom-0 left-0 right-0 p-12 glass backdrop-blur-md translate-y-4 group-hover:translate-y-0 transition-transform duration-500\" data-kid=\"67\">\n          <div class=\"flex justify-between items-center\" data-kid=\"68\">\n            <div data-kid=\"69\">\n              <span class=\"text-cyan text-xs tracking-widest uppercase mb-2 block\" data-kid=\"70\">AI Interface</span>\n              <h3 class=\"text-3xl font-bold\" data-kid=\"71\">Neural Stream</h3>\n            </div>\n            <a href=\"#\" class=\"w-16 h-16 rounded-full bg-cyan flex items-center justify-center text-black hover:scale-110 transition-transform\" data-kid=\"72\">\n              <i class=\"ti ti-arrow-up-right text-2xl\" data-kid=\"73\"></i>\n            </a>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"shrink-0 w-[700px] h-[500px] relative rounded-3xl overflow-hidden group\" data-kid=\"74\">\n        <img src=\"https://images.unsplash.com/photo-1642240228932-bbd2885a1caf?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110\" alt=\"Project 3\" loading=\"lazy\" decoding=\"async\" data-kid=\"75\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent\" data-kid=\"76\"></div>\n        <div class=\"absolute bottom-0 left-0 right-0 p-12 glass backdrop-blur-md translate-y-4 group-hover:translate-y-0 transition-transform duration-500\" data-kid=\"77\">\n          <div class=\"flex justify-between items-center\" data-kid=\"78\">\n            <div data-kid=\"79\">\n              <span class=\"text-cyan text-xs tracking-widest uppercase mb-2 block\" data-kid=\"80\">Blockchain Core</span>\n              <h3 class=\"text-3xl font-bold\" data-kid=\"81\">Ether Flow</h3>\n            </div>\n            <a href=\"#\" class=\"w-16 h-16 rounded-full bg-cyan flex items-center justify-center text-black hover:scale-110 transition-transform\" data-kid=\"82\">\n              <i class=\"ti ti-arrow-up-right text-2xl\" data-kid=\"83\"></i>\n            </a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"experience\" class=\"py-32 px-24 relative overflow-hidden\" data-kid=\"84\">\n    <div class=\"max-w-4xl mx-auto\" data-kid=\"85\">\n      <span class=\"text-cyan text-sm tracking-[0.5em] uppercase mb-4 block\" data-kid=\"86\">Timeline</span>\n      <h2 class=\"text-6xl font-bold italic font-serif mb-24\" data-kid=\"87\">The Sinuous Path</h2>\n\n      <div class=\"relative pl-12\" data-kid=\"88\">\n        \n        <div class=\"absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-cyan via-cyan/20 to-transparent\" data-kid=\"89\"></div>\n        \n        \n        <div class=\"space-y-24\" data-kid=\"90\">\n          <div class=\"relative group\" data-kid=\"91\">\n            <div class=\"absolute -left-[53px] top-0 w-10 h-10 rounded-full glass border-cyan/50 flex items-center justify-center bg-[#0A0A0A] z-10\" data-kid=\"92\">\n              <div class=\"w-2 h-2 rounded-full bg-cyan glow-cyan group-hover:scale-150 transition-transform\" data-kid=\"93\"></div>\n            </div>\n            <div class=\"p-10 glass rounded-[2rem] hover:border-cyan/50 transition-all duration-700\" data-kid=\"94\">\n              <div class=\"flex justify-between items-start mb-6\" data-kid=\"95\">\n                <div data-kid=\"96\">\n                  <h3 class=\"text-3xl font-bold tracking-tight\" data-kid=\"97\">Lead Software Architect</h3>\n                  <p class=\"text-cyan font-medium mt-2\" data-kid=\"98\">Global Tech Monolith • 2022 — Present</p>\n                </div>\n                <span class=\"px-4 py-2 glass rounded-full text-[10px] tracking-widest uppercase\" data-kid=\"99\">Senior Tier</span>\n              </div>\n              <p class=\"text-white/60 leading-relaxed max-w-2xl\" data-kid=\"100\">Directing technical vision for enterprise-scale React applications, pioneering fluid animation systems and high-performance backend integrations.</p>\n            </div>\n          </div>\n\n          <div class=\"relative group\" data-kid=\"101\">\n            <div class=\"absolute -left-[53px] top-0 w-10 h-10 rounded-full glass border-white/20 flex items-center justify-center bg-[#0A0A0A] z-10\" data-kid=\"102\">\n              <div class=\"w-2 h-2 rounded-full bg-white/40 group-hover:bg-cyan group-hover:scale-150 transition-all\" data-kid=\"103\"></div>\n            </div>\n            <div class=\"p-10 glass rounded-[2rem] hover:border-cyan/50 transition-all duration-700 opacity-60 hover:opacity-100\" data-kid=\"104\">\n              <div class=\"flex justify-between items-start mb-6\" data-kid=\"105\">\n                <div data-kid=\"106\">\n                  <h3 class=\"text-3xl font-bold tracking-tight\" data-kid=\"107\">Full Stack Developer</h3>\n                  <p class=\"text-cyan font-medium mt-2\" data-kid=\"108\">Next Gen Solutions • 2020 — 2022</p>\n                </div>\n                <span class=\"px-4 py-2 glass rounded-full text-[10px] tracking-widest uppercase\" data-kid=\"109\">Core Team</span>\n              </div>\n              <p class=\"text-white/60 leading-relaxed max-w-2xl\" data-kid=\"110\">Spearheaded the development of proprietary CMS systems using Node.js and Next.js, optimizing delivery speed by 40% across all client nodes.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"contact\" class=\"min-h-screen py-32 px-24 flex items-center justify-center relative overflow-hidden\" data-kid=\"111\">\n    \n    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full opacity-20 pointer-events-none\" data-kid=\"112\">\n       <video src=\"https://videos.pexels.com/video-files/35146064/14888529_640_360_30fps.mp4\" autoplay muted loop playsinline class=\"w-full h-full object-cover blur-[100px]\" decoding=\"async\" data-kid=\"113\"></video>\n    </div>\n\n    <div class=\"w-full max-w-3xl glass rounded-[4rem] p-20 relative z-10 backdrop-blur-[60px] border-white/10 shadow-2xl\" data-kid=\"114\">\n      <div class=\"text-center mb-16\" data-kid=\"115\">\n        <div class=\"inline-flex items-center gap-4 mb-8\" data-kid=\"116\">\n           <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/waving-hand.svg\" class=\"w-12 h-12\" alt=\"wave\" data-kid=\"117\">\n           <span class=\"text-cyan text-sm tracking-[0.6em] uppercase\" data-kid=\"118\">Let's Talk</span>\n        </div>\n        <h2 class=\"text-6xl font-bold italic font-serif\" data-kid=\"119\">Initiate Connection</h2>\n      </div>\n\n      <form class=\"space-y-12\" data-kid=\"120\">\n        <div class=\"grid grid-cols-2 gap-12\" data-kid=\"121\">\n          <div class=\"relative group\" data-kid=\"122\">\n            <label class=\"text-[10px] tracking-[0.3em] uppercase text-white/40 mb-2 block\" data-kid=\"123\">Identification</label>\n            <input type=\"text\" placeholder=\"Your Name\" class=\"w-full bg-transparent border-b border-white/10 py-4 outline-none focus:border-cyan transition-colors text-lg\" data-kid=\"124\">\n          </div>\n          <div class=\"relative group\" data-kid=\"125\">\n            <label class=\"text-[10px] tracking-[0.3em] uppercase text-white/40 mb-2 block\" data-kid=\"126\">Terminal Address</label>\n            <input type=\"email\" placeholder=\"Your Email\" class=\"w-full bg-transparent border-b border-white/10 py-4 outline-none focus:border-cyan transition-colors text-lg\" data-kid=\"127\">\n          </div>\n        </div>\n        <div class=\"relative group\" data-kid=\"128\">\n          <label class=\"text-[10px] tracking-[0.3em] uppercase text-white/40 mb-2 block\" data-kid=\"129\">Data Payload</label>\n          <textarea rows=\"4\" placeholder=\"How can I help you engineering excellence?\" class=\"w-full bg-transparent border-b border-white/10 py-4 outline-none focus:border-cyan transition-colors text-lg resize-none\" data-kid=\"130\"></textarea>\n        </div>\n        <button class=\"w-full py-8 rounded-full bg-white text-black font-bold text-xl tracking-widest uppercase hover:bg-cyan hover:scale-[1.02] transition-all duration-500 shadow-xl\" data-kid=\"131\">\n          Transmit Message\n        </button>\n      </form>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-12 px-24 flex justify-between items-center glass border-t-0 border-white/5\" data-kid=\"132\">\n    <p class=\"text-sm text-white/30 tracking-widest uppercase\" data-kid=\"133\">© 2026 Abhay Pandey • All Rights Reserved</p>\n    <div class=\"flex gap-8\" data-kid=\"134\">\n      <a href=\"#\" class=\"text-white/30 hover:text-cyan transition-colors\" data-kid=\"135\"><i class=\"ti ti-brand-github text-xl\" data-kid=\"136\"></i></a>\n      <a href=\"#\" class=\"text-white/30 hover:text-cyan transition-colors\" data-kid=\"137\"><i class=\"ti ti-brand-linkedin text-xl\" data-kid=\"138\"></i></a>\n      <a href=\"#\" class=\"text-white/30 hover:text-cyan transition-colors\" data-kid=\"139\"><i class=\"ti ti-brand-x text-xl\" data-kid=\"140\"></i></a>\n    </div>\n  </footer>\n</div>\n\n<script type=\"module\" data-kid=\"141\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  import { animate, scroll, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Initialize Smooth Scrolling\n  const lenis = new Lenis()\n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n\n  // About Text Scroll Reveal\n  const aboutText = document.querySelector('#about-text');\n  scroll(\n    animate(aboutText, { \n      opacity: [0, 1], \n      y: [100, 0] \n    }, { easing: \"ease-out\" }),\n    { \n      target: aboutText,\n      offset: [\"start end\", \"end center\"]\n    }\n  );\n\n  // Staggered In-View for Cards\n  inView(\"#about .grid > div\", (info) => {\n    animate(info.target, { \n      opacity: [0, 1], \n      y: [50, 0] \n    }, { \n      delay: 0.2, \n      duration: 0.8,\n      easing: \"ease-out\" \n    });\n  });\n\n  // Project Track Navigation\n  const track = document.querySelector('#project-track');\n  document.querySelector('#nextBtn').addEventListener('click', () => {\n    track.scrollBy({ left: 600, behavior: 'smooth' });\n  });\n  document.querySelector('#prevBtn').addEventListener('click', () => {\n    track.scrollBy({ left: -600, behavior: 'smooth' });\n  });\n</script>",
