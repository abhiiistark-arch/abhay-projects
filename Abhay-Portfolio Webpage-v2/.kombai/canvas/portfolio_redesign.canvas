      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Inter:wght@300;400;600;700&display=swap');\n\n  :root {\n    --deep-space: #0A0A0A;\n    --rich-charcoal: #111111;\n    --warm-accent: #FF8A4D;\n    --soft-gray: #CCCCCC;\n    --hairline: rgba(255, 255, 255, 0.1);\n  }\n\n  body {\n    background-color: var(--deep-space);\n    color: white;\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-serif { font-family: 'Cormorant Garamond', serif; }\n  .font-sans { font-family: 'Inter', sans-serif; }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--hairline);\n  }\n\n  .hairline-v {\n    width: 1px;\n    height: 100%;\n    background: var(--hairline);\n  }\n\n  .hairline-h {\n    height: 1px;\n    width: 100%;\n    background: var(--hairline);\n  }\n\n  .vertical-text {\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n  }\n\n  /* Video Mask Trick */\n  .hero-mask-container {\n    background-color: var(--deep-space);\n    mix-blend-mode: multiply;\n  }\n\n  .text-reveal-mask {\n    color: white;\n    background: var(--deep-space);\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar {\n    width: 4px;\n  }\n  ::-webkit-scrollbar-track {\n    background: var(--deep-space);\n  }\n  ::-webkit-scrollbar-thumb {\n    background: var(--warm-accent);\n  }\n</style>\n\n\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n<script type=\"module\" data-kid=\"2\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  const lenis = new Lenis();\n  function raf(time) {\n    lenis.raf(time);\n    requestAnimationFrame(raf);\n  }\n  requestAnimationFrame(raf);\n</script>\n\n\n<nav class=\"fixed top-0 left-0 w-full z-50 px-12 py-8 flex justify-between items-center mix-blend-difference\" data-kid=\"3\">\n  <div class=\"text-xl font-semibold tracking-tighter\" data-kid=\"4\">AP<span class=\"text-[var(--warm-accent)]\" data-kid=\"5\">.</span></div>\n  <div class=\"flex gap-12 text-xs uppercase tracking-[0.2em] font-medium\" data-kid=\"6\">\n    <a href=\"#about\" class=\"hover:text-[var(--warm-accent)] transition-colors\" data-kid=\"7\">Architecture</a>\n    <a href=\"#projects\" class=\"hover:text-[var(--warm-accent)] transition-colors\" data-kid=\"8\">Monoliths</a>\n    <a href=\"#experience\" class=\"hover:text-[var(--warm-accent)] transition-colors\" data-kid=\"9\">The Ruler</a>\n    <a href=\"#contact\" class=\"hover:text-[var(--warm-accent)] transition-colors\" data-kid=\"10\">Terminal</a>\n  </div>\n</nav>\n\n\n<section class=\"relative h-screen w-full flex flex-col justify-center items-center overflow-hidden bg-black\" data-kid=\"11\">\n  \n  <video src=\"https://videos.pexels.com/video-files/37259189/15784116_640_360_24fps.mp4\" poster=\"https://images.pexels.com/videos/37259189/cinematic-crest-dark-deep-37259189.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 w-full h-full object-cover opacity-60 scale-110\" data-kid=\"12\"></video>\n\n  \n  <div class=\"relative z-10 flex flex-col items-center\" data-kid=\"13\">\n    <h1 class=\"font-serif text-[18vw] leading-none tracking-tighter uppercase font-bold text-white mix-blend-overlay\" data-kid=\"14\">\n      Abhay\n    </h1>\n    <div class=\"w-full max-w-6xl mt-12 grid grid-cols-3 gap-8 px-12 opacity-80\" data-kid=\"15\">\n      <div class=\"flex flex-col gap-2 border-l border-[var(--warm-accent)] pl-6\" data-kid=\"16\">\n        <span class=\"text-[10px] uppercase tracking-widest text-white/50\" data-kid=\"17\">Role</span>\n        <span class=\"text-sm font-medium tracking-tight\" data-kid=\"18\">Full Stack Architect</span>\n      </div>\n      <div class=\"flex flex-col gap-2 border-l border-[var(--warm-accent)] pl-6\" data-kid=\"19\">\n        <span class=\"text-[10px] uppercase tracking-widest text-white/50\" data-kid=\"20\">Location</span>\n        <span class=\"text-sm font-medium tracking-tight\" data-kid=\"21\">Digital Space</span>\n      </div>\n      <div class=\"flex flex-col gap-2 border-l border-[var(--warm-accent)] pl-6\" data-kid=\"22\">\n        <span class=\"text-[10px] uppercase tracking-widest text-white/50\" data-kid=\"23\">Status</span>\n        <span class=\"text-sm font-medium tracking-tight\" data-kid=\"24\">Ready for Engineering</span>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"absolute bottom-12 flex flex-col items-center gap-4 opacity-40 animate-bounce\" data-kid=\"25\">\n    <span class=\"text-[10px] uppercase tracking-[0.3em] vertical-text\" data-kid=\"26\">Scroll</span>\n    <div class=\"w-px h-12 bg-white\" data-kid=\"27\"></div>\n  </div>\n</section>\n\n\n<section id=\"about\" class=\"relative min-h-screen py-32 px-12 grid grid-cols-12 gap-12 items-center\" data-kid=\"28\">\n  \n  <div class=\"col-span-5 border-r border-[var(--hairline)] pr-12 h-full flex flex-col justify-center\" data-kid=\"29\">\n    <h2 class=\"font-serif text-6xl mb-12 italic\" data-kid=\"30\">The <br data-kid=\"31\">Architecture</h2>\n    <div class=\"space-y-8\" data-kid=\"32\">\n      <div class=\"group\" data-kid=\"33\">\n        <div class=\"flex items-center gap-4 mb-2\" data-kid=\"34\">\n          <i class=\"ti ti-cpu text-[var(--warm-accent)] text-xl\" data-kid=\"35\"></i>\n          <span class=\"text-xs uppercase tracking-widest font-bold\" data-kid=\"36\">Front-End Systems</span>\n        </div>\n        <div class=\"text-sm text-white/60 font-light leading-relaxed\" data-kid=\"37\">\n          React, Next.js, Tailwind, Framer Motion, GSAP. Crafted for high-fidelity interactions.\n        </div>\n      </div>\n      <div class=\"group\" data-kid=\"38\">\n        <div class=\"flex items-center gap-4 mb-2\" data-kid=\"39\">\n          <i class=\"ti ti-database text-[var(--warm-accent)] text-xl\" data-kid=\"40\"></i>\n          <span class=\"text-xs uppercase tracking-widest font-bold\" data-kid=\"41\">Back-End Logic</span>\n        </div>\n        <div class=\"text-sm text-white/60 font-light leading-relaxed\" data-kid=\"42\">\n          Node.js, PostgreSQL, Redis, GraphQL. Engineered for scale and resilience.\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"mt-12 pt-12 border-t border-[var(--hairline)] flex justify-between items-center opacity-30\" data-kid=\"43\">\n      <div class=\"text-[10px] font-mono\" data-kid=\"44\">X: 1440.00</div>\n      <div class=\"text-[10px] font-mono\" data-kid=\"45\">Y: 2880.00</div>\n      <div class=\"text-[10px] font-mono\" data-kid=\"46\">SCALE: 1:1</div>\n    </div>\n  </div>\n\n  \n  <div class=\"col-span-7 space-y-12\" data-kid=\"47\">\n    <div class=\"relative\" data-kid=\"48\">\n      \n      <img src=\"https://images.unsplash.com/photo-1518611540400-6b85a0704342?auto=format&w=800&q=80&fit=crop\" alt=\"Abhay Pandey\" class=\"w-full h-[600px] object-cover grayscale brightness-75 contrast-125\" decoding=\"async\" loading=\"lazy\" data-kid=\"49\">\n      \n      <div class=\"absolute -bottom-12 -left-12 max-w-md glass-card p-12 border-t-2 border-t-[var(--warm-accent)]\" data-kid=\"50\">\n        <p class=\"font-serif text-2xl italic leading-snug mb-6\" data-kid=\"51\">\n          \"I build high-performance digital artifacts where every pixel is engineered with intent and every interaction feels superhuman.\"\n        </p>\n        <p class=\"text-xs leading-loose text-white/70\" data-kid=\"52\">\n          Abhay Pandey is a software engineer focused on bridging the gap between raw technical power and editorial design. With over years of experience in full-stack ecosystems, he creates experiences that are as robust as they are beautiful.\n        </p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"projects\" class=\"py-32 bg-[var(--rich-charcoal)]\" data-kid=\"53\">\n  <div class=\"px-12 mb-24 flex justify-between items-end\" data-kid=\"54\">\n    <h2 class=\"font-serif text-8xl\" data-kid=\"55\">The <br data-kid=\"56\">Monoliths</h2>\n    <div class=\"text-xs text-white/40 max-w-xs text-right uppercase tracking-widest leading-loose\" data-kid=\"57\">\n      Selected works representing massive engineering efforts and structural design precision.\n    </div>\n  </div>\n\n  <div class=\"space-y-0\" data-kid=\"58\">\n    \n    <div class=\"group relative flex border-t border-[var(--hairline)] overflow-hidden h-[70vh]\" data-kid=\"59\">\n      <div class=\"w-24 flex items-center justify-center border-r border-[var(--hairline)] bg-[var(--deep-space)]\" data-kid=\"60\">\n        <span class=\"vertical-text font-serif text-3xl uppercase tracking-tighter group-hover:text-[var(--warm-accent)] transition-colors\" data-kid=\"61\">\n          Apex CRM\n        </span>\n      </div>\n      <div class=\"flex-grow relative overflow-hidden\" data-kid=\"62\">\n        <img src=\"https://images.unsplash.com/photo-1488972685288-c3fd157d7c7a?auto=format&w=1200&q=80&fit=crop\" alt=\"Apex CRM\" class=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"63\">\n        <div class=\"absolute inset-0 bg-gradient-to-r from-[var(--deep-space)] to-transparent opacity-60\" data-kid=\"64\"></div>\n        <div class=\"absolute bottom-12 left-12 max-w-lg\" data-kid=\"65\">\n          <span class=\"text-[10px] uppercase tracking-widest text-[var(--warm-accent)] mb-4 block\" data-kid=\"66\">01 / Fintech Solution</span>\n          <p class=\"text-sm text-white/80 leading-relaxed\" data-kid=\"67\">\n            A high-performance CRM built for elite trading teams. Featuring real-time data streaming and a brutalist design system.\n          </p>\n          <a href=\"#\" class=\"mt-8 inline-flex items-center gap-4 text-xs font-bold uppercase tracking-widest group/link\" data-kid=\"68\">\n            Examine Project <i class=\"ti ti-arrow-up-right group-hover/link:translate-x-1 group-hover/link:-translate-y-1 transition-transform\" data-kid=\"69\"></i>\n          </a>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"group relative flex border-t border-b border-[var(--hairline)] overflow-hidden h-[70vh]\" data-kid=\"70\">\n      <div class=\"w-24 flex items-center justify-center border-r border-[var(--hairline)] bg-[var(--deep-space)]\" data-kid=\"71\">\n        <span class=\"vertical-text font-serif text-3xl uppercase tracking-tighter group-hover:text-[var(--warm-accent)] transition-colors\" data-kid=\"72\">\n          Nova Design System\n        </span>\n      </div>\n      <div class=\"flex-grow relative overflow-hidden\" data-kid=\"73\">\n        <img src=\"https://images.unsplash.com/photo-1527576539890-dfa815648363?auto=format&w=1200&q=80&fit=crop\" alt=\"Nova Design System\" class=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"74\">\n        <div class=\"absolute inset-0 bg-gradient-to-r from-[var(--deep-space)] to-transparent opacity-60\" data-kid=\"75\"></div>\n        <div class=\"absolute bottom-12 left-12 max-w-lg\" data-kid=\"76\">\n          <span class=\"text-[10px] uppercase tracking-widest text-[var(--warm-accent)] mb-4 block\" data-kid=\"77\">02 / Infrastructure</span>\n          <p class=\"text-sm text-white/80 leading-relaxed\" data-kid=\"78\">\n            Redefining component architecture with a focus on motion-driven UX and structural integrity.\n          </p>\n          <a href=\"#\" class=\"mt-8 inline-flex items-center gap-4 text-xs font-bold uppercase tracking-widest group/link\" data-kid=\"79\">\n            Examine Project <i class=\"ti ti-arrow-up-right group-hover/link:translate-x-1 group-hover/link:-translate-y-1 transition-transform\" data-kid=\"80\"></i>\n          </a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"experience\" class=\"py-32 px-12 bg-[var(--deep-space)]\" data-kid=\"81\">\n  <div class=\"grid grid-cols-12 gap-12\" data-kid=\"82\">\n    <div class=\"col-span-4\" data-kid=\"83\">\n      <h2 class=\"font-serif text-7xl italic sticky top-32\" data-kid=\"84\">The <br data-kid=\"85\">Ruler</h2>\n    </div>\n    <div class=\"col-span-8 relative border-l border-[var(--warm-accent)] ml-6\" data-kid=\"86\">\n      \n      <div class=\"absolute left-[-5px] top-0 bottom-0 w-2 overflow-hidden flex flex-col justify-between py-2\" data-kid=\"87\">\n        <div class=\"h-px w-4 bg-[var(--warm-accent)]\" data-kid=\"88\"></div>\n        <div class=\"h-px w-2 bg-[var(--warm-accent)]\" data-kid=\"89\"></div>\n        <div class=\"h-px w-2 bg-[var(--warm-accent)]\" data-kid=\"90\"></div>\n        <div class=\"h-px w-2 bg-[var(--warm-accent)]\" data-kid=\"91\"></div>\n        <div class=\"h-px w-4 bg-[var(--warm-accent)]\" data-kid=\"92\"></div>\n        <div class=\"h-px w-2 bg-[var(--warm-accent)]\" data-kid=\"93\"></div>\n        <div class=\"h-px w-2 bg-[var(--warm-accent)]\" data-kid=\"94\"></div>\n        <div class=\"h-px w-2 bg-[var(--warm-accent)]\" data-kid=\"95\"></div>\n        <div class=\"h-px w-4 bg-[var(--warm-accent)]\" data-kid=\"96\"></div>\n      </div>\n\n      <div class=\"pl-16 space-y-32\" data-kid=\"97\">\n        \n        <div class=\"relative\" data-kid=\"98\">\n          <div class=\"absolute left-[-72px] top-1 text-xs font-mono text-[var(--warm-accent)]\" data-kid=\"99\">2023 — PRES</div>\n          <h3 class=\"font-serif text-4xl italic mb-4\" data-kid=\"100\">Senior Software Engineer</h3>\n          <p class=\"text-xs uppercase tracking-[0.2em] font-bold text-white/40 mb-6\" data-kid=\"101\">HighTech Collective</p>\n          <p class=\"max-w-xl text-sm leading-loose text-white/60\" data-kid=\"102\">\n            Leading the development of complex enterprise applications. Implementing high-precision design systems and optimizing performance across distributed systems.\n          </p>\n        </div>\n\n        \n        <div class=\"relative\" data-kid=\"103\">\n          <div class=\"absolute left-[-72px] top-1 text-xs font-mono text-[var(--warm-accent)]\" data-kid=\"104\">2021 — 2023</div>\n          <h3 class=\"font-serif text-4xl italic mb-4\" data-kid=\"105\">Full Stack Developer</h3>\n          <p class=\"text-xs uppercase tracking-[0.2em] font-bold text-white/40 mb-6\" data-kid=\"106\">Creative Ops Engine</p>\n          <p class=\"max-w-xl text-sm leading-loose text-white/60\" data-kid=\"107\">\n            Architected the front-end for a global e-commerce platform. Specialized in React performance tuning and immersive animation sequences.\n          </p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"contact\" class=\"min-h-screen py-32 px-12 bg-black flex flex-col justify-center\" data-kid=\"108\">\n  <div class=\"max-w-6xl mx-auto w-full\" data-kid=\"109\">\n    <div class=\"mb-24\" data-kid=\"110\">\n      <h2 class=\"font-serif text-9xl tracking-tighter uppercase font-bold text-white/10\" data-kid=\"111\">The Terminal</h2>\n    </div>\n    \n    <div class=\"space-y-24\" data-kid=\"112\">\n      <div class=\"relative group\" data-kid=\"113\">\n        <label class=\"text-[10px] uppercase tracking-[0.4em] text-[var(--warm-accent)] mb-4 block\" data-kid=\"114\">Message Entry</label>\n        <input type=\"text\" placeholder=\"ENTER YOUR REQUIREMENTS...\" class=\"w-full bg-transparent border-none outline-none font-serif text-6xl italic placeholder:text-white/5 group-hover:placeholder:text-white/10 transition-all text-white\" data-kid=\"115\">\n        <div class=\"absolute bottom-0 left-0 w-full h-px bg-white/10 group-focus-within:h-1 group-focus-within:bg-[var(--warm-accent)] transition-all\" data-kid=\"116\"></div>\n        <div class=\"absolute right-0 top-1/2 -translate-y-1/2 w-4 h-12 bg-[var(--warm-accent)] animate-pulse hidden group-focus-within:block\" data-kid=\"117\"></div>\n      </div>\n\n      <div class=\"flex justify-between items-end\" data-kid=\"118\">\n        <div class=\"space-y-4\" data-kid=\"119\">\n          <p class=\"text-[10px] uppercase tracking-widest text-white/40\" data-kid=\"120\">Direct Outreach</p>\n          <a href=\"mailto:hello@abhay.dev\" class=\"text-2xl font-serif italic hover:text-[var(--warm-accent)] transition-colors\" data-kid=\"121\">hello@abhay.dev</a>\n        </div>\n        \n        <button class=\"px-12 py-6 bg-white text-black font-bold uppercase text-xs tracking-[0.3em] hover:bg-[var(--warm-accent)] hover:text-white transition-all transform hover:-translate-y-1\" data-kid=\"122\">\n          Transmit Data\n        </button>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<footer class=\"py-12 px-12 border-t border-[var(--hairline)] flex justify-between items-center text-[10px] uppercase tracking-widest text-white/20\" data-kid=\"123\">\n  <p data-kid=\"124\">&copy; 2024 Abhay Pandey // Structured Power</p>\n  <div class=\"flex gap-8\" data-kid=\"125\">\n    <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"126\">GitHub</a>\n    <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"127\">LinkedIn</a>\n    <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"128\">Twitter</a>\n  </div>\n</footer>\n\n<script type=\"module\" data-kid=\"129\">\n  import { animate, scroll, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Reveal Animations\n  inView(\"section\", ({ target }) => {\n    animate(\n      target.querySelectorAll(\"h1, h2, h3, p, img, .group\"),\n      { opacity: [0, 1], y: [50, 0], filter: [\"blur(10px)\", \"blur(0px)\"] },\n      { duration: 1, delay: 0.2, easing: [0.17, 0.55, 0.55, 1] }\n    );\n  });\n\n  // Project Monolith Parallax\n  scroll(\n    animate(\".hero-mask-container\", { scale: [1, 1.2] }),\n    { target: document.querySelector(\"section\") }\n  );\n</script>",
