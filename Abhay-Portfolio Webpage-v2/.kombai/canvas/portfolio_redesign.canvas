      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');\n\n  :root {\n    --deep-space: #0A0A0A;\n    --rich-charcoal: #111111;\n    --warm-accent: #FF8A4D;\n    --electric-cyan: #00F5FF;\n    --glass: rgba(255, 255, 255, 0.03);\n    --glass-border: rgba(255, 255, 255, 0.08);\n  }\n\n  body {\n    background-color: var(--deep-space);\n    color: white;\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-serif { font-family: 'Cormorant Garamond', serif; }\n  \n  .glass-shard {\n    background: var(--glass);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--glass-border);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .glass-shard::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, transparent 100%);\n    pointer-events: none;\n  }\n\n  .transmission-input {\n    background: transparent;\n    border: none;\n    border-bottom: 1px solid rgba(255,255,255,0.1);\n    width: 100%;\n    padding: 12px 0;\n    color: white;\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 1.5rem;\n    transition: border-color 0.3s ease;\n  }\n\n  .transmission-input:focus {\n    outline: none;\n    border-color: var(--warm-accent);\n  }\n\n  .transmission-label {\n    font-size: 0.7rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.4);\n    display: block;\n    margin-bottom: 4px;\n  }\n\n  /* Custom Cursor - visual only for canvas */\n  .custom-cursor {\n    width: 10px;\n    height: 10px;\n    background: var(--warm-accent);\n    border-radius: 50%;\n    position: fixed;\n    pointer-events: none;\n    z-index: 9999;\n    mix-blend-mode: difference;\n  }\n\n  /* Smoke Video Container */\n  .smoke-bg {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: 0.4;\n    mix-blend-mode: screen;\n  }\n\n  .noise-overlay {\n    position: fixed;\n    inset: 0;\n    background: url('https://grainy-gradients.vercel.app/noise.svg');\n    opacity: 0.05;\n    pointer-events: none;\n    z-index: 100;\n  }\n</style>\n\n<div class=\"noise-overlay\" data-kid=\"1\"></div>\n\n\n<nav class=\"fixed top-0 left-0 w-full z-50 px-12 py-8 flex justify-between items-center pointer-events-none\" data-kid=\"2\">\n  <div class=\"pointer-events-auto\" data-kid=\"3\">\n    <span class=\"font-serif text-xl tracking-widest uppercase\" data-kid=\"4\">A. Pandey</span>\n  </div>\n  <div class=\"flex gap-12 pointer-events-auto\" data-kid=\"5\">\n    <a href=\"#about\" class=\"text-[10px] uppercase tracking-[0.3em] hover:text-warm-accent transition-colors\" data-kid=\"6\">/ About</a>\n    <a href=\"#projects\" class=\"text-[10px] uppercase tracking-[0.3em] hover:text-warm-accent transition-colors\" data-kid=\"7\">/ Projects</a>\n    <a href=\"#experience\" class=\"text-[10px] uppercase tracking-[0.3em] hover:text-warm-accent transition-colors\" data-kid=\"8\">/ Experience</a>\n    <a href=\"#contact\" class=\"text-[10px] uppercase tracking-[0.3em] hover:text-warm-accent transition-colors\" data-kid=\"9\">/ Contact</a>\n  </div>\n</nav>\n\n\n<section class=\"relative h-screen w-full flex items-center justify-center overflow-hidden bg-deep-space\" data-kid=\"10\">\n  \n  <div class=\"absolute inset-0 opacity-20\" data-kid=\"11\">\n    <img id=\"heroWireframe\" src=\"https://images.unsplash.com/photo-1649939929524-681f8b1faa07?auto=format&w=1440&q=80\" alt class=\"w-full h-full object-cover grayscale invert\" data-kid=\"12\">\n    <div class=\"absolute inset-0 bg-gradient-to-b from-deep-space via-transparent to-deep-space\" data-kid=\"13\"></div>\n  </div>\n\n  \n  <div class=\"absolute inset-0 p-16 pointer-events-none\" data-kid=\"14\">\n    <div class=\"h-full w-full relative\" data-kid=\"15\">\n      <h2 class=\"hero-text absolute top-0 left-0 text-[8vw] font-serif leading-none tracking-tighter opacity-10\" data-kid=\"16\">ABHAY</h2>\n      <h2 class=\"hero-text absolute top-0 right-0 text-[8vw] font-serif leading-none tracking-tighter opacity-10\" data-kid=\"17\">PANDEY</h2>\n      <h2 class=\"hero-text absolute bottom-0 left-0 text-[8vw] font-serif leading-none tracking-tighter opacity-10 uppercase\" data-kid=\"18\">AI</h2>\n      <h2 class=\"hero-text absolute bottom-0 right-0 text-[8vw] font-serif leading-none tracking-tighter opacity-10 uppercase\" data-kid=\"19\">Engineer</h2>\n    </div>\n  </div>\n\n  \n  <div class=\"relative z-10 text-center\" data-kid=\"20\">\n    <div class=\"relative inline-block\" data-kid=\"21\">\n      <div class=\"absolute -inset-20 bg-warm-accent/5 blur-[120px] rounded-full\" data-kid=\"22\"></div>\n      <div class=\"glass-shard w-[400px] h-[500px] rounded-sm p-1\" data-kid=\"23\">\n        <div class=\"relative w-full h-full overflow-hidden\" data-kid=\"24\">\n          <img src=\"/api/local/images/images/hero-portrait.jpg\" alt=\"Abhay\" class=\"w-full h-full object-cover grayscale brightness-75\" data-kid=\"25\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-deep-space to-transparent opacity-60\" data-kid=\"26\"></div>\n          \n          <div class=\"absolute bottom-12 left-0 w-full px-8 text-left\" data-kid=\"27\">\n            <span class=\"text-[10px] uppercase tracking-[0.4em] text-warm-accent mb-2 block\" data-kid=\"28\">AI System Architect</span>\n            <h1 class=\"font-serif text-5xl leading-tight\" data-kid=\"29\">Solving at the<br data-kid=\"30\"><span class=\"italic\" data-kid=\"31\">Edge of Intellect.</span></h1>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4\" data-kid=\"32\">\n    <span class=\"text-[9px] uppercase tracking-[0.5em] text-white/30\" data-kid=\"33\">Scroll to Explore</span>\n    <div class=\"w-px h-16 bg-gradient-to-b from-warm-accent to-transparent\" data-kid=\"34\"></div>\n  </div>\n</section>\n\n\n<section id=\"about\" class=\"relative min-h-screen w-full bg-rich-charcoal flex flex-col items-center justify-center py-32 overflow-hidden\" data-kid=\"35\">\n  \n  <video class=\"smoke-bg\" src=\"https://videos.pexels.com/video-files/4320606/4320606-uhd_2560_1440_24fps.mp4\" autoplay muted loop playsinline poster=\"https://images.pexels.com/videos/4320606/pexels-photo-4320606.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" data-kid=\"36\"></video>\n  \n  <div class=\"relative z-10 max-w-7xl mx-auto px-12 grid grid-cols-1 lg:grid-cols-12 gap-24 items-center\" data-kid=\"37\">\n    \n    <div class=\"lg:col-span-5 relative\" data-kid=\"38\">\n      <div class=\"relative\" data-kid=\"39\">\n        \n        <div class=\"glass-shard w-full aspect-[4/5] z-10 rotate-[-2deg] transition-transform hover:rotate-0 duration-700\" data-kid=\"40\">\n          <img src=\"/api/local/images/images/about-portrait.png\" alt=\"Abhay\" class=\"w-full h-full object-cover\" data-kid=\"41\">\n        </div>\n        \n        <div class=\"glass-shard absolute top-12 -left-12 w-full h-full -z-10 rotate-[4deg] opacity-50 blur-sm\" data-kid=\"42\"></div>\n        \n        <div class=\"absolute -bottom-12 -right-12 p-8 glass-shard border-warm-accent/20\" data-kid=\"43\">\n          <span class=\"font-serif text-4xl italic text-warm-accent\" data-kid=\"44\">\"Run before you can walk.\"</span>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"lg:col-span-7\" data-kid=\"45\">\n      <div class=\"glass-shard p-12 rounded-lg border-white/5\" data-kid=\"46\">\n        <span class=\"text-xs uppercase tracking-[0.5em] text-white/30 mb-8 block\" data-kid=\"47\">01 / Identity</span>\n        <h2 class=\"font-serif text-6xl mb-12\" data-kid=\"48\">Architecting Autonomous <span class=\"italic text-electric-cyan\" data-kid=\"49\">Realities.</span></h2>\n        \n        <div class=\"space-y-6 text-white/60 text-lg leading-relaxed\" data-kid=\"50\">\n          <p data-kid=\"51\">Hi! I'm <span class=\"text-white\" data-kid=\"52\">Abhay Pandey</span>, an AI Engineer & Analyst passionate about building intelligent systems that solve real-world business problems. I specialize in <span class=\"text-electric-cyan\" data-kid=\"53\">Agentic AI</span>, <span class=\"text-electric-cyan\" data-kid=\"54\">Retrieval-Augmented Generation (RAG)</span>, and <span class=\"text-electric-cyan\" data-kid=\"55\">Intelligent Automation</span>.</p>\n          <p data-kid=\"56\">My work involves designing AI agents, developing advanced RAG architectures, building real-time voice assistants, and deploying end-to-end AI applications using modern cloud and AI technologies. I don't just write code; I architect systems that work.</p>\n        </div>\n\n        <div class=\"mt-16 grid grid-cols-2 gap-8\" data-kid=\"57\">\n          <div data-kid=\"58\">\n            <span class=\"text-[10px] uppercase tracking-widest text-warm-accent mb-4 block\" data-kid=\"59\">Core Expertise</span>\n            <ul class=\"font-serif text-xl space-y-2 text-white/80\" data-kid=\"60\">\n              <li data-kid=\"61\">Agentic Systems</li>\n              <li data-kid=\"62\">RAG Pipelines</li>\n              <li data-kid=\"63\">Computer Vision</li>\n            </ul>\n          </div>\n          <div data-kid=\"64\">\n            <span class=\"text-[10px] uppercase tracking-widest text-electric-cyan mb-4 block\" data-kid=\"65\">Technology</span>\n            <ul class=\"font-serif text-xl space-y-2 text-white/80\" data-kid=\"66\">\n              <li data-kid=\"67\">LangGraph & CrewAI</li>\n              <li data-kid=\"68\">PyTorch / TensorFlow</li>\n              <li data-kid=\"69\">AWS & Azure Infra</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"contact\" class=\"relative h-screen w-full bg-deep-space flex items-center overflow-hidden\" data-kid=\"70\">\n  \n  <video class=\"absolute inset-0 w-full h-full object-cover opacity-20 pointer-events-none\" src=\"https://videos.pexels.com/video-files/4320718/4320718-sd_960_540_30fps.mp4\" autoplay muted loop playsinline data-kid=\"71\"></video>\n\n  <div class=\"relative z-10 w-full h-full grid grid-cols-1 lg:grid-cols-2\" data-kid=\"72\">\n    \n    <div class=\"p-24 flex flex-col justify-between border-r border-white/5\" data-kid=\"73\">\n      <div data-kid=\"74\">\n        <div class=\"mb-24\" data-kid=\"75\">\n          <span class=\"font-serif text-2xl tracking-[0.1em]\" data-kid=\"76\">A. PANDEY</span>\n          <p class=\"text-[10px] uppercase tracking-[0.4em] text-white/30 mt-1\" data-kid=\"77\">PORTFOLIO VOL. 03</p>\n        </div>\n        \n        <div class=\"space-y-2\" data-kid=\"78\">\n          <span class=\"text-[10px] uppercase tracking-[0.5em] text-white/30 block\" data-kid=\"79\">TRANSMISSION</span>\n          <h2 class=\"font-serif text-[9vw] leading-[0.85] tracking-tight\" data-kid=\"80\">Initiate<br data-kid=\"81\">Contact.</h2>\n        </div>\n      </div>\n\n      <div data-kid=\"82\">\n        <a href=\"mailto:hello@abhay.dev\" class=\"group relative inline-block\" data-kid=\"83\">\n          <span class=\"font-serif text-5xl border-b border-white/40 pb-2 group-hover:border-warm-accent transition-colors\" data-kid=\"84\">hello@abhay.dev</span>\n        </a>\n        \n        <div class=\"mt-12 flex gap-12 text-[10px] uppercase tracking-[0.3em] text-white/40\" data-kid=\"85\">\n          <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"86\">LINKEDIN</a>\n          <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"87\">GITHUB</a>\n          <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"88\">TWITTER / X</a>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"p-24 flex flex-col justify-center bg-rich-charcoal/40 backdrop-blur-sm\" data-kid=\"89\">\n      <div class=\"max-w-xl w-full space-y-20\" data-kid=\"90\">\n        <div class=\"flex gap-12\" data-kid=\"91\">\n           <span class=\"text-[10px] uppercase tracking-[0.3em] text-warm-accent\" data-kid=\"92\">ID / ABOUT</span>\n           <span class=\"text-[10px] uppercase tracking-[0.3em] text-white/20\" data-kid=\"93\">/ PROJECTS</span>\n           <span class=\"text-[10px] uppercase tracking-[0.3em] text-white/20\" data-kid=\"94\">/ EXPERIENCE</span>\n        </div>\n\n        <div class=\"space-y-12\" data-kid=\"95\">\n          <div class=\"form-group\" data-kid=\"96\">\n            <label class=\"transmission-label\" data-kid=\"97\">IDENTITY / ABOUT</label>\n            <input type=\"text\" placeholder=\"Your Name\" class=\"transmission-input\" data-kid=\"98\">\n          </div>\n          <div class=\"form-group\" data-kid=\"99\">\n            <label class=\"transmission-label\" data-kid=\"100\">DIGITAL ADDRESS</label>\n            <input type=\"email\" placeholder=\"email@provider.com\" class=\"transmission-input\" data-kid=\"101\">\n          </div>\n          <div class=\"form-group\" data-kid=\"102\">\n            <label class=\"transmission-label\" data-kid=\"103\">CONFESSION</label>\n            <textarea placeholder=\"Your Message...\" class=\"transmission-input h-32 resize-none\" data-kid=\"104\"></textarea>\n          </div>\n        </div>\n\n        <button class=\"w-full h-32 border border-white/10 hover:border-warm-accent group transition-all relative overflow-hidden\" data-kid=\"105\">\n          <div class=\"absolute inset-0 bg-warm-accent/5 translate-y-full group-hover:translate-y-0 transition-transform duration-500\" data-kid=\"106\"></div>\n          <span class=\"font-serif text-3xl italic relative z-10 group-hover:tracking-widest transition-all\" data-kid=\"107\">Send Transmission</span>\n        </button>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"108\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"109\"></script>\n<script type=\"module\" data-kid=\"110\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  \n  gsap.registerPlugin(ScrollTrigger);\n\n  // Initialize Smooth Scroll\n  const lenis = new Lenis({\n    lerp: 0.1,\n    wheelMultiplier: 1.2,\n    infinite: false,\n  })\n\n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n\n  // GSAP Animations\n  // Hero Parallax\n  gsap.to(\"#heroWireframe\", {\n    y: 150,\n    scale: 1.1,\n    scrollTrigger: {\n      trigger: \"section\",\n      start: \"top top\",\n      end: \"bottom top\",\n      scrub: true\n    }\n  });\n\n  gsap.to(\".hero-text\", {\n    y: (i, target) => {\n      const isTop = target.classList.contains('top-0');\n      return isTop ? 100 : -100;\n    },\n    opacity: 0.3,\n    scrollTrigger: {\n      trigger: \"section\",\n      start: \"top top\",\n      end: \"bottom top\",\n      scrub: true\n    }\n  });\n\n  // Reveal Sections\n  gsap.utils.toArray('section').forEach(section => {\n    gsap.from(section.querySelectorAll('.glass-shard, h2, p, .form-group'), {\n      y: 50,\n      opacity: 0,\n      duration: 1.5,\n      stagger: 0.1,\n      ease: \"power4.out\",\n      scrollTrigger: {\n        trigger: section,\n        start: \"top 80%\",\n      }\n    });\n  });\n\n  // Custom Cursor\n  const cursor = document.createElement('div');\n  cursor.className = 'custom-cursor';\n  document.body.appendChild(cursor);\n\n  window.addEventListener('mousemove', (e) => {\n    gsap.to(cursor, {\n      x: e.clientX,\n      y: e.clientY,\n      duration: 0.1,\n      ease: \"power2.out\"\n    });\n  });\n\n  document.querySelectorAll('a, button, input').forEach(el => {\n    el.addEventListener('mouseenter', () => {\n      gsap.to(cursor, { scale: 4, opacity: 0.5, duration: 0.3 });\n    });\n    el.addEventListener('mouseleave', () => {\n      gsap.to(cursor, { scale: 1, opacity: 1, duration: 0.3 });\n    });\n  });\n</script>",
