# Google Gemini — only AI key required (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional: gemini-3.1-flash-live-preview (default, fastest) or gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore

# LiveKit Cloud — transport only (mic/speaker WebRTC connection)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
